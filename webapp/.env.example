# Local PostgreSQL (password is the one you chose when installing Postgres)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/technovision

# On Render: do not set DATABASE_URL here. Link a Postgres instance and Render injects it.

SESSION_SECRET=change-this-to-a-long-random-string
DEFAULT_NEW_USER_PASSWORD=12345
